# Ne mets jamais une vraie clé dans ce fichier ou dans GitHub.
OPENAI_API_KEY=
# Laisse vide sur Render pour utiliser l’API OpenAI officielle.
OPENAI_API_BASE=
# Base PostgreSQL Render : indispensable pour conserver économie, niveaux, liens et RPG après redéploiement.
DATABASE=
# Alias accepté par le registre OVL si la variable Render s’appelle DATABASE_URL.
DATABASE_URL=
OVL_DATABASE_URL=
# Sans PostgreSQL, ce fichier local reste éphémère sur Render sauf disque persistant monté.
OVL_REGISTRY_SQLITE=/var/data/ovl-registry.sqlite
OPENAI_MODEL=gpt-4o-mini
OPENAI_QUIZ_MODEL=gpt-4o-mini
OPENAI_CHATBOT_MODEL=gpt-5-mini
# Optionnel : nécessaire si Akinator bloque sur continue() après une proposition refusée.
SCRAPER_API_KEY=
SCRAPER_API_SESSION=
# legacy = ancien chatbot limité ; openai = chatbot OpenAI moderne.
CHATBOT_MODE=legacy
CHATBOT_LEGACY_FALLBACK=true
# Autoriser le fallback GPT sans recherche si web_search est indisponible.
OPENAI_CHATBOT_ALLOW_NO_SEARCH=true
